# Copy this file to ".env" (same folder as manage.py) and fill in your values.

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- PostgreSQL ---
DB_NAME=stockwise_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Set to True ONLY if you want to skip PostgreSQL for a quick test (uses a local file db.sqlite3)
USE_SQLITE=False

# --- Market data ---
# True = never go online, always use generated practice data (clearly marked "DEMO DATA")
FORCE_DEMO_DATA=False
# True = if Yahoo Finance fails, show practice data instead of an error
DEMO_FALLBACK=False
# How long (seconds) to reuse an analysis before downloading fresh prices
ANALYSIS_CACHE_SECONDS=900

# --- News ---
# Free key from https://gnews.io  (sign up -> Dashboard -> copy "API key")
# Leave empty and the app still shows news from free backup sources.
GNEWS_API_KEY=
# How long (seconds) to reuse news before asking again (saves your 100 free requests/day)
NEWS_CACHE_SECONDS=1800

# --- NLP news sentiment ---
# auto = FinBERT deep learning if set up (see README 11c), otherwise basic word list
# other options: wordlist, off
SENTIMENT_ENGINE=auto
